library(Rcpp)
ajustar_copula <- function(dados, marginal = "negbin", cormat = "arma.cormat(1,3)") {
if (!requireNamespace("gcmr", quietly = TRUE)) {
cat("Ajustando: Copula - PACOTE gcmr NÃO DISPONÍVEL\n")
cat("  Instale com: devtools::install_github('gmasarotto/gcmr')\n")
return(NULL)
}
nome <- paste0("Copula ", toupper(marginal), " ", toupper(cormat))
cat("Ajustando:", nome, "...\n")
# Preparar marginal
if (marginal == "poisson") {
marg <- gcmr::poisson.marg
} else if (marginal == "negbin") {
marg <- gcmr::negbin.marg
}
fit <- tryCatch({
gcmr::gcmr(Y ~ X_continua + X_categ + time,
data = dados,
marginal = marg,
id = indiv_id,
cormat = cormat,
options = gcmr.options(seed = 123))
}, error = function(e) {
cat("  ERRO:", e$message, "\n")
return(NULL)
})
if (is.null(fit)) return(NULL)
resultado <- list(
modelo = fit,
nome = nome,
tipo = "Copula",
AIC = AIC(fit),
BIC = BIC(fit),
convergiu = TRUE
)
cat("  ✓ AIC:", round(resultado$AIC, 2), "| BIC:", round(resultado$BIC, 2), "\n")
return(resultado)
}
