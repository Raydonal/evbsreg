install.packages("growthmodels")
library(growthmodels)
library(ggplot2)
# Modelo Logístico (Eq. 3.6)
model_logistic <- function(t, K, gamma, C0) {
K / (1 + ((K/C0) - 1) * exp(-gamma * t))
}
# Modelo Gompertz (Eq. 3.5 adaptada)
model_gompertz <- function(t, K, gamma, C0) {
# Parametrização comum onde C0 é o valor inicial
K * exp(log(C0/K) * exp(-gamma * t))
}
# Modelo Richards (Eq. 3.7)
model_richards <- function(t, K, gamma, C0, alpha) {
# O parâmetro alpha controla a assimetria
K * (1 - exp(alpha * gamma * t) * (1 - (C0/K)^(-alpha)))^(-1/alpha)
}
# 2. GERANDO DADOS SIMULADOS (Cenário com 2 fases)
set.seed(123)
t <- 1:100
d1 <- 50 # Ponto de mudança
# Fase 1 (1 a 50): Crescimento Logístico
y1 <- model_logistic(1:d1, K=1000, gamma=0.15, C0=10)
# Fase 2 (51 a 100): Mudança de dinâmica (Gompertz com novo teto)
# Note que o C0 da fase 2 é o final da fase 1
y2 <- model_gompertz(1:(100-d1), K=2500, gamma=0.08, C0=y1[d1])
# Unindo e adicionando ruído de Poisson (comum em epidemiologia)
y_obs <- rpois(100, c(y1, y2))
df <- data.frame(t = t, y = y_obs)
# 3. AJUSTE DOS MODELOS (Exemplo para a Fase 1)
df1 <- subset(df, t <= d1)
# Ajuste Logístico
fit_log <- nls(y ~ model_logistic(t, K, gamma, C0), data = df1,
start = list(K=1200, gamma=0.1, C0=5))
# Ajuste Gompertz
fit_gomp <- nls(y ~ model_gompertz(t, K, gamma, C0), data = df1,
start = list(K=1200, gamma=0.1, C0=5))
# Ajuste Richards (Fixando alpha=1.5 como na tese pág. 54)
fit_rich <- nls(y ~ model_richards(t, K, gamma, C0, alpha=1.5), data = df1,
start = list(K=1200, gamma=0.1, C0=5))
library(minpack.lm)
# Instale se não tiver: install.packages("minpack.lm")
library(minpack.lm)
library(ggplot2)
# 1. FUNÇÕES COM PROTEÇÃO (evitar valores negativos onde não deve)
model_logistic <- function(t, K, gamma, C0) {
K / (1 + ((K/C0) - 1) * exp(-gamma * t))
}
model_gompertz <- function(t, K, gamma, C0) {
# Proteção para garantir que C0 e K sejam positivos no log
K * exp(log(abs(C0/K)) * exp(-gamma * t))
}
model_richards <- function(t, K, gamma, C0, alpha) {
# Richards é muito instável, alpha fixo ajuda
term <- 1 - exp(alpha * gamma * t) * (1 - (abs(C0/K))^(-alpha))
K * (abs(term))^(-1/alpha)
}
# 2. SIMULAÇÃO DOS DADOS
set.seed(123)
t <- 1:50
y_pure <- model_logistic(t, K=1000, gamma=0.2, C0=10)
y_obs <- rpois(50, y_pure)
df1 <- data.frame(t=t, y=y_obs)
# Ajuste Logístico
fit_log <- nlsLM(y ~ model_logistic(t, K, gamma, C0),
data = df1,
start = list(K=1200, gamma=0.1, C0=5),
lower = c(100, 0.001, 1)) # Impede valores negativos
# Ajuste Gompertz
fit_gomp <- nlsLM(y ~ model_gompertz(t, K, gamma, C0),
data = df1,
start = list(K=1200, gamma=0.1, C0=5),
lower = c(100, 0.001, 1))
# Ajuste Richards
fit_rich <- nlsLM(y ~ model_richards(t, K, gamma, C0, alpha=1.5),
data = df1,
start = list(K=1200, gamma=0.1, C0=5),
lower = c(100, 0.001, 1))
# 4. RESULTADOS E AIC
summary(fit_log)
AIC(fit_log, fit_gomp, fit_rich)
summary(fit_log)
summary(fit_gomp)
summary(fit_rich)
# 4. RESULTADOS E AIC
AIC(fit_log, fit_gomp, fit_rich)
# Tabela de AIC (Quanto menor, melhor)
aics <- AIC(fit_log, fit_gomp, fit_rich)
print("--- Comparação de Modelos (Fase 1) ---")
print(aics)
# Cálculo dos Pesos do Ensemble baseados no AIC (Akaike Weights)
# Isso resolve o problema da penalização por parâmetros!
delta_aic <- aics$AIC - min(aics$AIC)
weights <- exp(-0.5 * delta_aic) / sum(exp(-0.5 * delta_aic))
aics$Weight <- weights
print(aics)
# 5. VISUALIZAÇÃO
df1$pred_log <- predict(fit_log)
df1$pred_gomp <- predict(fit_gomp)
df1$pred_rich <- predict(fit_rich)
ggplot(df1, aes(x=t, y=y)) +
geom_point(alpha=0.4) +
geom_line(aes(y=pred_log, color="Logístico"), size=1) +
geom_line(aes(y=pred_gomp, color="Gompertz"), size=1) +
geom_line(aes(y=pred_rich, color="Richards"), size=1, linetype="dashed") +
labs(title="Ajuste de Modelos de Crescimento - Fase 1",
color="Modelo", y="Casos Acumulados") +
theme_minimal()
# -------------------------------------------------------------------------
# COMPARAÇÃO DE ESTRATÉGIAS DE ENSEMBLE: EQM (TESE) VS AIC (PROPOSTA)
# -------------------------------------------------------------------------
if(!require(minpack.lm)) install.packages("minpack.lm")
if(!require(ggplot2)) install.packages("ggplot2")
library(minpack.lm)
library(ggplot2)
# 1. DEFINIÇÃO DOS MODELOS (Com proteção contra valores ilegais)
model_logistic <- function(t, K, gamma, C0) {
K / (1 + ((K/abs(C0)) - 1) * exp(-gamma * t))
}
model_gompertz <- function(t, K, gamma, C0) {
K * exp(log(abs(C0/K)) * exp(-gamma * t))
}
model_richards <- function(t, K, gamma, C0, alpha = 1.5) {
term <- 1 - exp(alpha * gamma * t) * (1 - (abs(C0/K))^(-alpha))
K * (abs(term))^(-1/alpha)
}
# 2. SIMULAÇÃO DOS DADOS (Cenário de 2 fases)
set.seed(123)
t_f1 <- 1:50
t_f2 <- 51:100
# Fase 1: Gerada via Logístico
y_f1 <- model_logistic(t_f1, K=1000, gamma=0.15, C0=10)
# Fase 2: Gerada via Gompertz (mudança de teto)
y_f2 <- model_gompertz(1:50, K=2500, gamma=0.08, C0=y_f1[50])
df <- data.frame(t = c(t_f1, t_f2),
y = rpois(100, c(y_f1, y_f2)))
# 3. FUNÇÃO DE AJUSTE COM COMPARAÇÃO DE PESOS
comparar_pesos <- function(dados) {
dados$t_rel <- dados$t - min(dados$t)
max_y <- max(dados$y)
# Ajustes
f_log  <- nlsLM(y ~ model_logistic(t_rel, K, gamma, C0), data=dados,
start=list(K=max_y*1.1, gamma=0.1, C0=10), lower=c(1, 0.001, 1))
f_gomp <- nlsLM(y ~ model_gompertz(t_rel, K, gamma, C0), data=dados,
start=list(K=max_y*1.1, gamma=0.1, C0=10), lower=c(1, 0.001, 1))
f_rich <- nlsLM(y ~ model_richards(t_rel, K, gamma, C0, alpha=1.5), data=dados,
start=list(K=max_y*1.1, gamma=0.1, C0=10), lower=c(1, 0.001, 1))
# ESTRATÉGIA 1: PESOS VIA EQM (Original da Tese)
eqms <- c(mean(residuals(f_log)^2), mean(residuals(f_gomp)^2), mean(residuals(f_rich)^2))
inv_eqm <- 1 / eqms
pesos_eqm <- inv_eqm / sum(inv_eqm)
# ESTRATÉGIA 2: PESOS VIA AIC (Akaike Weights)
aics <- AIC(f_log, f_gomp, f_rich)$AIC
delta_aic <- aics - min(aics)
rel_lik <- exp(-0.5 * delta_aic)
pesos_aic <- rel_lik / sum(rel_lik)
# Predições individuais
p_log <- predict(f_log); p_gomp <- predict(f_gomp); p_rich <- predict(f_rich)
# Predições Ensemble
pred_ens_eqm <- pesos_eqm[1]*p_log + pesos_eqm[2]*p_gomp + pesos_eqm[3]*p_rich
pred_ens_aic <- pesos_aic[1]*p_log + pesos_aic[2]*p_gomp + pesos_aic[3]*p_rich
return(list(pred_eqm = pred_ens_eqm, pred_aic = pred_ens_aic,
pesos_eqm = pesos_eqm, pesos_aic = pesos_aic))
}
# 4. APLICAÇÃO NAS DUAS FASES
res1 <- comparar_pesos(df[1:50,])
res2 <- comparar_pesos(df[51:100,])
df$ensemble_EQM <- c(res1$pred_eqm, res2$pred_eqm)
df$ensemble_AIC <- c(res1$pred_aic, res2$pred_aic)
# 5. TABELA COMPARATIVA DE PESOS
tabela_comparativa <- data.frame(
Modelo = rep(c("Logístico", "Gompertz", "Richards"), 2),
Fase = c(rep("Fase 1", 3), rep("Fase 2", 3)),
Peso_EQM = c(res1$pesos_eqm, res2$pesos_eqm),
Peso_AIC = c(res1$pesos_aic, res2$pesos_aic)
)
print("--- Comparação de Pesos por Estratégia ---")
print(tabela_comparativa)
# 6. GRÁFICO DE COMPARAÇÃO FINAL
ggplot(df, aes(x=t, y=y)) +
geom_point(alpha=0.3, color="black") +
geom_line(aes(y=ensemble_EQM, color="Ensemble EQM (Tese)"), size=1.2) +
geom_line(aes(y=ensemble_AIC, color="Ensemble AIC (Sugerido)"), size=1.2, linetype="dashed") +
geom_vline(xintercept = 50, linetype="dotted", color="red") +
labs(title="Comparação de Estratégias de Ponderação",
subtitle="EQM (Inverso do Erro) vs AIC (Penalização por Complexidade)",
x="Dias", y="Casos Acumulados", color="Estratégia") +
theme_minimal() +
theme(legend.position = "bottom")
install.packages("~/Downloads/files(11)/simplexgof_0.1.0.tar.gz", repos = NULL, type = "source")
### ** Examples
data(ammonia)
X <- cbind(1, ammonia$corr_ar, ammonia$temp_agua,
ammonia$corr_ar * ammonia$temp_agua)
Z <- cbind(1, ammonia$temp_agua,
ammonia$corr_ar * ammonia$temp_agua)
fit <- simplex_fit(ammonia$perda, X, Z)
dg  <- simplex_diag(fit, J.method = c("analytic", "finitediff"))
plot(dg$Cei, type = "h",
xlab = "Observation", ylab = expression(C[It]),
main = "Local influence (case-weight perturbation)")
abline(h = 2 * mean(dg$Cei), lty = 2, col = "red")
